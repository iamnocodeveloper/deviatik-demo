# InsForge backend
# 1. Link the project locally first:
#      npx @insforge/cli link --project-id <project-id> --org-id <org-id>
# 2. Copy this file to `.env` and replace the placeholders.
# 3. Get the anon key with:
#      npx @insforge/cli secrets get ANON_KEY
# 4. The URL is also available in `.insforge/project.json` (`oss_host`).

VITE_INSFORGE_URL=https://your-app.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=replace-with-your-anon-key